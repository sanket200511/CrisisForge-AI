# CrisisForge AI Backend Environment Configuration Example
# Copy to backend/.env and populate with deployment-specific credentials.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./crisisforge.db
# For PostgreSQL: postgresql://user:password@localhost:5432/crisisforge

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://crisisforge-ai.vercel.app

# Security & Authentication:
# Set to 'true' in production to enforce verified Bearer token authentication on API endpoints.
AUTH_ENABLED=false
API_AUTH_TOKEN=

# Audit Logging:
AUDIT_LOGGING_ENABLED=true

# Telegram Bot Integration:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_MINUTES=5
